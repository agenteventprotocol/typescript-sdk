{
  "name": "@agenteventprotocol/sdk",
  "version": "0.1.0-dev",
  "description": "AEP 0.1 SDK: emit/consume/control helpers over the schema-generated envelope and payload types",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenteventprotocol/typescript-sdk.git"
  },
  "homepage": "https://github.com/agenteventprotocol/typescript-sdk#readme",
  "bugs": "https://github.com/agenteventprotocol/typescript-sdk/issues",
  "keywords": [
    "aep",
    "agent-events",
    "observability",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "npx --yes -p typescript@6.0.3 tsc -p . --noEmit",
    "build": "npx --yes -p typescript@6.0.3 tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "ws": "^8.18.0"
  }
}
